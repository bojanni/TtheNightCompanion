# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nightcafe_companion

# Encryption key for stored API keys
ENCRYPTION_KEY=your-secret-key-here

# Server
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# HuggingFace token (optional)
# Increases rate limit from 1,000 to 100,000 requests/day
# Get your token at: https://huggingface.co/settings/tokens (read scope is sufficient)
# Can also be set via the API Keys settings page in the app
HF_TOKEN=your_token_here
